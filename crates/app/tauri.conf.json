  "productName": "EQLP Companion",
  "version": "0.1.0",
  "identifier": "com.eqlp.companion",
  "build": {
    "frontendDist": "../../ui/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
