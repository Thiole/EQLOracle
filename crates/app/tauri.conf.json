{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EQLP Companion",
  "version": "0.1.0",
  "identifier": "com.eqlp.companion",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EQLP Companion",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
