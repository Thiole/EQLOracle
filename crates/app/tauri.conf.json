{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EQL Oracle",
  "version": "0.7.0",
  "identifier": "com.eqlp.oracle",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui", "wait": false },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EQL Oracle",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMEYxNDI1NkI4NDA1QTcKUldTbkJZUnJKUlFQd25EVUhYVGtDVUl3RVh6dnAxSFoxNXgyUFQvdnpOYlB6eEZpN3d0anRKL3EK",
      "endpoints": ["https://github.com/Thiole/EQLOracle/releases/download/latest/latest.json"]
    }
  }
}
